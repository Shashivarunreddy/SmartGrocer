# --- Node & JavaScript Dependencies ---
node_modules/
*/node_modules/
.pnp
.pnp.js

# --- Environment & Secret Variables ---
.env
.env.*
*.env
!.env.example
!expo-env.d.ts
!*/expo-env.d.ts
*.pem
*.key
*.cert

# --- Python Virtual Envs, Caches & Bytecode ---
.venv/
*/.venv/
venv/
*/venv/
env/
*/env/
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Testing & Code Coverage ---
.pytest_cache/
*/.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.lcov
.nyc_output

# --- Expo, React Native & Metro ---
.expo/
*/.expo/
.expo-shared/
web-build/
*.jks
*.p8
*.p12
*.keystore
*.mobileprovision
metro-cache/
.metro-health-check*

