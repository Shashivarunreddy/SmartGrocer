# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
# Example for local PostgreSQL:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/smartgrocer?schema=public"

# Clerk Authentication (Get these from your Clerk Dashboard: https://dashboard.clerk.com -> API Keys)
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Python AI Microservice (FastAPI) - for future grocery demand and consumption predictions
PYTHON_SERVICE_URL="http://localhost:8000"
